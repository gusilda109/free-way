# Скопируйте в .env и при необходимости поменяйте значения.

# --- Маршрут ---
# valhalla — движок на данных OpenStreetMap (тот же, что на openstreetmap.org),
#            публичный сервер FOSSGIS, ключ не нужен. По умолчанию.
# ors      — OpenRouteService, нужен ORS_API_KEY.
ROUTER=valhalla
VALHALLA_URL=https://valhalla1.openstreetmap.de

# Только для ROUTER=ors (бесплатный ключ: https://account.heigit.org/signup)
ORS_API_KEY=
ORS_BASE_URL=https://api.heigit.org/openrouteservice

# --- Пилотный район: запад,юг,восток,север (долгота/широта) ---
# Используется и клиентом, и сервером.
VITE_PILOT_BOUNDS=83.05,54.82,83.14,54.875
VITE_PILOT_NAME=Академгородок, Новосибирск

# Подложка карты. Тайлы tile.openstreetmap.org годятся для разработки;
# для пилота выберите провайдера и проверьте условия атрибуции.
VITE_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# Порт API и папка с данными (база SQLite + фото)
PORT=8787
DATA_DIR=./data
# Лимит хранилища фото, МБ. При превышении добавление блокируется.
STORAGE_LIMIT_MB=1024
